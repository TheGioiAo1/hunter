# ============================================================================
# Gbox Platform — Environment Variables
# Copy to .env and fill in values for your environment
# ============================================================================

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://gbox:password@localhost:5432/gbox_platform

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Authentication ----
# Session secret: generate with `openssl rand -hex 32`
AUTH_SECRET=generate-with-openssl-rand-hex-32

# Cookie domain — TWO DIFFERENT VARS for TWO DIFFERENT AUTH SURFACES.
# Both MUST be set in prod or cross-subdomain login silently breaks
# (Set-Cookie lands with Domain=host, browser drops it on the next
# subdomain request, user sees login form again after correct creds).
#
#   SESSION_COOKIE_DOMAIN — MERCHANT sessions (accounts → admin →
#     god-admin → {slug}.admin). Read by
#     packages/core/src/modules/auth/session.ts.
#   CUSTOMER_COOKIE_DOMAIN — CUSTOMER sessions (storefront → checkout).
#     Read by apps/checkout/src/server.ts and
#     packages/core/src/modules/customer-auth/middleware.ts.
#
# Always use a leading dot (`.gbox.co`, NOT `gbox.co`) so the cookie
# is shared across all subdomains. Leave empty for single-host dev
# (the browser scopes to the exact request host, which is correct).
# Production example: both = `.gbox.co`.
SESSION_COOKIE_DOMAIN=.gbox.co
CUSTOMER_COOKIE_DOMAIN=.gbox.co

# ---- Server Ports (PM2 ecosystem overrides these, but useful for local dev) ----
# PORT=4321              # Main API
# STORE_ADMIN_PORT=4325  # Store Admin
# ACCOUNTS_PORT=4323     # Accounts Portal
# GOD_ADMIN_PORT=4324    # God Admin
# STOREFRONT_PORT=4326   # Storefront SSR
# CHECKOUT_PORT=4327     # Checkout Server

# ---- Platform URLs (used in emails, redirects, handoff tokens) ----
PLATFORM_URL=https://gbox.co
CHECKOUT_URL=https://checkout.gbox.co
ACCOUNTS_URL=https://accounts.gbox.co
API_URL=https://api.gbox.co

# ---- Cloudflare (dev/preview only — not needed for VPS production) ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---- Storage (legacy R2 — theme engine, Phase 1) ----
# Will be deprecated after spec §21 migration to S3.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gbox-theme-assets
R2_PUBLIC_BASE_URL=https://cdn.gbox.co

# ---- Storage (Phase B — AWS S3 buckets, spec §4.1) ----
# Credentials are optional in production when the app runs on EC2/ECS
# with an attached IAM role (GboxBackendRole). Fill in here ONLY for
# local dev + CI. Primary region: Singapore; DR replica: Tokyo.
AWS_REGION=ap-southeast-1
AWS_DR_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# One bucket per role. Do not share buckets across roles — IAM boundaries
# + lifecycle rules + CORS all differ per bucket (spec §4.1).
S3_PUBLIC_BUCKET=gbox-public-media-prod
S3_THEME_LIBRARY_BUCKET=gbox-theme-library-prod
S3_PRIVATE_BUCKET=gbox-private-prod
S3_BACKUPS_BUCKET=gbox-backups-prod

# Legacy single-bucket vars — kept for older code paths that haven't
# migrated to the role-based factory. Will be removed once §21 migration
# completes.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=gbox-platform
S3_REGION=ap-southeast-1
S3_ENDPOINT=

# ---- CDN (Phase B — Cloudflare + imgproxy front, spec §10-11) ----
# Image provider: 'imgproxy' (production), 'passthrough' (dev), or
# 'cloudflare' / 'imgix' / 'local' (legacy, unused).
GBOX_IMAGE_CDN=imgproxy
CDN_PUBLIC_BASE_URL=https://cdn.gbox.co
CDN_THEME_LIBRARY_BASE_URL=https://cdn.gbox.co

# imgproxy HMAC signing. BOTH keys are 64-char hex strings (32 raw
# bytes each). Generate with:
#   openssl rand -hex 32
# Must match the values passed to the imgproxy container via
# IMGPROXY_KEY / IMGPROXY_SALT env vars. Rotate quarterly; imgproxy
# supports multiple keys simultaneously for seamless rollover.
IMGPROXY_KEY=
IMGPROXY_SALT=
IMGPROXY_SIGNATURE_SIZE=32

# Cloudflare purge API (used after image replace / theme publish).
CF_ZONE_ID=
CF_API_TOKEN=

# Download Worker — shared HS256 secret with apps/cdn-worker.
# Generate with `openssl rand -hex 32`.
DOWNLOAD_JWT_SECRET=generate-with-openssl-rand-hex-32
# Bearer token the Worker sends to backend when requesting a signed URL.
# Generate with `openssl rand -hex 32`.
DOWNLOAD_SIGN_TOKEN=generate-with-openssl-rand-hex-32

# ---- Payment: PayPal Partner Platform (merchant onboarding) ----
# BETA POLICY (2026-04-21): PayPal is the ONLY payment partner for
# the Gbox beta. Each store owner connects their own PayPal via
# Partner Referral onboarding; payments land directly in the merchant's
# PayPal (Gbox acts as the facilitator, never touches the money).
#
# BN code `Gbox_Ecom` is our registered PayPal Partner Attribution
# Code — it MUST be attached to every Orders v2 / Refunds v2 call so
# PayPal credits Gbox as the integrator. See
# packages/core/src/modules/payments/paypal-partner/auth.ts.
PAYPAL_PARTNER_CLIENT_ID=
PAYPAL_PARTNER_SECRET=
PAYPAL_PARTNER_ID=
PAYPAL_PARTNER_BN_CODE=Gbox_Ecom
PAYPAL_SANDBOX=false
PAYPAL_WEBHOOK_ID=

# ---- Payment: Stripe (DISABLED FOR BETA) ----
# Leave Stripe env vars unset in beta prod — gateway-selector.ts treats
# STRIPE_SECRET_KEY=empty as "Stripe unavailable", so merchants who
# haven't finished PayPal onboarding will see "Payment unavailable,
# contact support" instead of falling back to Stripe.
# Uncomment AFTER beta when a secondary gateway is approved by owner.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Payment: PayPal Direct (LEGACY — Woo-era fallback, prefer Partner) ----
# Kept as an escape hatch for shops whose Partner onboarding is stuck.
# Under normal beta ops these stay empty.
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=

# ---- Email (SMTP / Amazon SES) ----
# Transactional + marketing email in Phase 12 beta goes straight to SES
# via nodemailer (email/service.ts). The SMTP_GBOX_URL hook below is
# wired for Phase 14 when marketing moves off the critical path.
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@gbox.co
# Optional: email templates directory override
# EMAIL_TEMPLATES_DIR=./templates/email

# ---- SMTP-Gbox relay (Phase 14 marketing engine — DISABLED in beta) ----
# Leave empty in Phase 12 beta. When we cut marketing emails over to the
# standalone SMTP-Gbox relay (per docs/ops/smtp-gbox-integration.md),
# set this to the private URL (e.g. http://127.0.0.1:4328) and
# email/service.ts will route templates with category='marketing' to
# the relay while keeping transactional categories on direct nodemailer.
# An empty value keeps today's single-path SES behavior unchanged.
SMTP_GBOX_URL=

# ---- Checkout Handoff (HMAC signing for cross-domain checkout) ----
# Generate with `openssl rand -hex 32`
CHECKOUT_HANDOFF_SECRET=generate-with-openssl-rand-hex-32

# ---- Logging ----
# Pino log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ---- Feature Flags ----
# Store-onboarding wizard (Phase E/F, 2026-04-18). Set to 'false' to
# kill-switch the wizard in place on server 1 without a redeploy:
#   - onboarding-gate middleware becomes a no-op (no forced redirects
#     out of the dashboard for pending shops)
#   - accounts portal's create-store flow reverts to the legacy
#     /accounts/store-created bounce (skips /welcome-to-admin)
# Any value other than the exact literal 'false' (case-insensitive)
# keeps the wizard live. Default (unset) = enabled.
GBOX_ONBOARDING_WIZARD_ENABLED=true

# ---- Node.js ----
NODE_ENV=production
# TZ=Asia/Ho_Chi_Minh

# ---------------------------------------------------------------------------
# AI Assistant (Anthropic Claude) — Phase 2 Admin Polish
# ---------------------------------------------------------------------------
# Used by god-admin detail pages (order detail, revenue breakdown,
# customer detail, ...) to surface an embedded chat panel that can
# analyze the current board and answer operator questions.
#
# - ANTHROPIC_API_KEY: issued at console.anthropic.com. Without this the
#   panel falls back to a stub "AI is not configured" card so the rest
#   of the page still loads.
# - AI_MODEL: model ID to use. Default is the latest Sonnet which
#   balances cost + quality for the short analytical tasks we do here.
#   For heavier analysis swap to claude-opus-4-6. Keep in sync with
#   packages/core/src/modules/ai/client.ts default.
# - AI_MAX_TOKENS: cap the response size to keep latency and cost
#   predictable. 1500 tokens is ~1000 words which fits the panel layout.
# - AI_ENABLED: hard kill switch. Set to "false" to disable the panel
#   entirely even when a key is set (useful during incident/cost spikes).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_MAX_TOKENS=1500
AI_ENABLED=true

# ---------------------------------------------------------------------------
# PR #10 — 2FA + IP Allowlist (Phase 0.7 §8)
# ---------------------------------------------------------------------------
# TOTP secrets are stored encrypted in the DB using this key. Generate
# once with `openssl rand -hex 32` and NEVER rotate in-place — rotation
# requires all enrolled users to re-enroll.
TWO_FACTOR_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
# When set to "true", every god-admin session must complete TOTP
# before accessing any route other than /login/2fa. Leave unset on
# initial bootstrap so the seeded god admin can enroll first.
ENFORCE_TWO_FACTOR=false
# Per-admin IP allowlist policy. When "enforce" any login from an
# IP not in admin_ip_allowlist is rejected with 403. "warn" logs but
# allows. "off" disables the check entirely.
ADMIN_IP_ALLOWLIST_MODE=off

# ---------------------------------------------------------------------------
# Clone Pro version selector (Phase 21 — AI-driven clone pipeline)
# ---------------------------------------------------------------------------
# Clone Pro v6 (Phase 21 — AI-driven clone pipeline). Default to v6.
# Set to 'v5' or 'v4' to roll back if needed.
CLONE_PRO_VERSION=v6
