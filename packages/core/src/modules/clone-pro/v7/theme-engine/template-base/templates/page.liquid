{% comment %} Generic CMS page (about / contact / faq / etc.). {% endcomment %}
<article class="page-content">
  <div class="container">
    <header class="page-header">
      <h1 class="page-title">{{ page.title }}</h1>
    </header>
    <div class="page-body">
      {{ page.content }}
    </div>
  </div>
</article>
