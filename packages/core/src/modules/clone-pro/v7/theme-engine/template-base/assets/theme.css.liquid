/* Clone Pro v7 — generated theme stylesheet
 * Tokens are injected at render time by token-applier.ts. The
 * applier emits a `:root { --… }` block at the top of theme.css and
 * appends this body verbatim. We keep the body small and rely on
 * CSS variables so swapping a token doesn't require re-rendering
 * every section.
 */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  font-family: var(--font-primary, system-ui, -apple-system, sans-serif);
  color: var(--color-foreground, #111);
  background: var(--color-background, #fff);
  line-height: 1.5;
}

body {
  margin: 0;
  font-size: 16px;
}

a { color: inherit; text-decoration: none; }
img { max-width: 100%; height: auto; display: block; }

.sr-only {
  position: absolute !important;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0, 0, 0, 0);
  white-space: nowrap; border: 0;
}

.container {
  max-width: var(--container-max, 1240px);
  margin: 0 auto;
  padding: 0 calc(var(--space-base, 8px) * 3);
}

.btn {
  display: inline-block;
  padding: var(--button-padding-y, 12px) var(--button-padding-x, 24px);
  border-radius: var(--button-radius, 4px);
  background: var(--color-primary, #111);
  color: var(--color-background, #fff);
  border: 1px solid var(--color-primary, #111);
  font: inherit; cursor: pointer;
  transition: opacity 0.15s ease;
}

.btn:hover { opacity: 0.85; }
.btn-link { background: transparent; color: var(--color-primary, #111); border: 0; padding: 0; }

.product-grid {
  list-style: none; padding: 0;
  display: grid;
  gap: calc(var(--space-base, 8px) * 3);
}

.grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
.grid-cols-3 { grid-template-columns: repeat(3, 1fr); }
.grid-cols-4 { grid-template-columns: repeat(4, 1fr); }
.grid-cols-12 { grid-template-columns: repeat(12, 1fr); }

@media (max-width: 768px) {
  .grid-cols-3, .grid-cols-4, .grid-cols-12 {
    grid-template-columns: repeat(2, 1fr);
  }
}

.product-card {
  display: block;
  color: inherit;
}

.product-card__media img {
  width: 100%; height: 100%; object-fit: cover;
  border-radius: var(--card-radius, 0);
}

.product-card__title {
  font-size: 1rem; margin: calc(var(--space-base, 8px) * 1.5) 0 calc(var(--space-base, 8px) / 2);
}

.product-card__price { font-size: 0.95rem; opacity: 0.8; }
