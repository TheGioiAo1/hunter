{
  "delay": 1000,
  "item": {
    "xpath": "//div[contains(@class, 'product-item item')]",
    "elements": [
      {
        "name": "Title",
        "xpath": ".//p[contains(@class,'card-title')]",
        "attr": null,
        "replaces": null
      },
      {
        "name": "Image",
        "xpath": ".//img[contains(@class, 'object-fit-cover')]",
        "attr": "data-src",
        "replaces": []
      },
      {
        "name": "Link",
        "xpath": ".//a[contains(@class, 'text-decoration-none text-dark')]",
        "attr": "href",
        "replaces": [
			{
				"from":"/products/",
				"to":"https://{domain}/products/"
			}
		]
      },
	  {
        "name": "Price",
        "xpath": ".//span[contains(@class, 'currency')]",
        "attr": null,
        "replaces": null
      },
	  {
		  "name":"Galery",
		  "xpath":"",
		  "attr": null,
		"replaces": null
	  }
    ]
	
  } 
}