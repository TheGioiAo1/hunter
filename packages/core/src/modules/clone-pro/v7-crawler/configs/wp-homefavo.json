{
  "delay": 1000,
  "item": {
    "xpath": "//div[contains(@class, 'product-small box')]",
    "elements": [
      {
        "name": "Title",
        "xpath": ".//p[contains(@class, 'name product-title woocommerce-loop-product__title')]/a",
        "attr": null,
        "replaces": null
      },
      {
        "name": "Image",
        "xpath": ".//img[contains(@class, 'attachment-woocommerce_thumbnail size-woocommerce_thumbnail')]",
        "attr": "data-src",
        "replaces": [
			{
				"from":"-300x300.jpg",
				"to":".jpg"
			},
			{
				"from":"-300x300.png",
				"to":".png"
			},
			{
				"from":"-300x300.webp",
				"to":".webp"
			}
		]
      },
	  {
        "name": "Link",
        "xpath": ".//div[contains(@class, 'image-fade_in_back')]/a",
        "attr": "href",
        "replaces": null
      },
	  {
        "name": "Images",
        "xpath": ".//div[contains(@class, 'image-fade_in_back')]/a/img",
        "attr": "data-src",
        "replaces": [
			{
				"from":"-300x300.jpg",
				"to":".jpg"
			},
			{
				"from":"-300x300.png",
				"to":".png"
			},
			{
				"from":"-300x300.webp",
				"to":".webp"
			}
		]
      }
    ]
	
  } 
}

