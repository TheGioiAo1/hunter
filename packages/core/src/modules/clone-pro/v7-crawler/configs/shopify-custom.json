      {
        "name": "Image",
        "xpath": ".//a[contains(@class, 'grid__image')]/img",
        "attr": "src",
        "replaces": [
			
			{
				"from":"//cdn.shopify.com",
				"to":"https://cdn.shopify.com"
			},
			{
				"from":"_300x",
				"to":""
			}
		]
      }
      
    ]
  } 
}