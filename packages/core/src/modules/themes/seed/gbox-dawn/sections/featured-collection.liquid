<section class="featured-collection page-width">
  <header class="section-header">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p>{{ section.settings.subheading }}</p>
    {%- endif -%}
  </header>

  {%- assign collection_handle = section.settings.collection_handle -%}
  {%- if collection_handle != blank and collections[collection_handle] -%}
    {%- assign featured = collections[collection_handle] -%}
    <ul class="product-grid">
      {%- for product in featured.products limit: section.settings.products_to_show -%}
        <li>{% render 'product-card', product: product %}</li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p class="placeholder">{{ 'sections.featured_collection.empty' | t }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.featured_collection.settings.heading.label", "default": "Featured collection" },
    { "type": "text", "id": "subheading", "label": "t:sections.featured_collection.settings.subheading.label" },
    { "type": "collection", "id": "collection_handle", "label": "t:sections.featured_collection.settings.collection_handle.label" },
    { "type": "range", "id": "products_to_show", "label": "t:sections.featured_collection.settings.products_to_show.label", "min": 2, "max": 24, "step": 1, "default": 8 }
  ],
  "presets": [
    { "name": "t:sections.featured_collection.presets.default.name", "category": "Collection" }
  ]
}
{% endschema %}
