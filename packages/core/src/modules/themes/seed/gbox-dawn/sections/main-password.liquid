<div class="password page-width page-width--narrow text-center">
  <h1>{{ shop.name }}</h1>
  <p>{{ 'password.description' | t }}</p>

  {% form 'storefront_password' %}
    <label class="visually-hidden" for="password-input">{{ 'password.label' | t }}</label>
    <input id="password-input" type="password" name="password" required>
    <button type="submit" class="button button--primary">{{ 'password.submit' | t }}</button>
    {%- if form.errors -%}
      <p class="form__status form__status--error">{{ 'password.error' | t }}</p>
    {%- endif -%}
  {% endform %}
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": []
}
{% endschema %}
