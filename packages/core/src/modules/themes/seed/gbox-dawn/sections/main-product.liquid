{% render 'json-ld-product', product: product, shop: shop %}
<section class="product page-width">
  <div class="product__media">
    {%- if product.featured_image_object -%}
      <img
        src="{{ product.featured_image_object.src }}"
        alt="{{ product.featured_image_object.alt | default: product.title | escape }}"
        {%- if product.featured_image_object.width %} width="{{ product.featured_image_object.width }}"{% endif -%}
        {%- if product.featured_image_object.height %} height="{{ product.featured_image_object.height }}"{% endif -%}
        {%- if product.featured_image_object.srcset_json %}
        srcset="{{ product.featured_image_object.src | img_url: '300x' }} 300w, {{ product.featured_image_object.src | img_url: '600x' }} 600w, {{ product.featured_image_object.src | img_url: '1200x' }} 1200w"
        sizes="(max-width: 768px) 100vw, 50vw"
        {%- endif -%}
        decoding="async"
      >
    {%- elsif product.featured_image -%}
      <img src="{{ product.featured_image }}" alt="{{ product.title | escape }}">
    {%- else -%}
      <div class="product__media-placeholder"></div>
    {%- endif -%}

    {%- if product.image_objects and product.image_objects.size > 1 -%}
      <ul class="product__thumbnails">
        {%- for image in product.image_objects -%}
          <li>
            <img
              src="{{ image.src }}"
              alt="{{ image.alt | default: product.title | escape }} – {{ forloop.index }}"
              {%- if image.width %} width="{{ image.width }}"{% endif -%}
              {%- if image.height %} height="{{ image.height }}"{% endif -%}
              loading="lazy"
              decoding="async"
            >
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif product.images and product.images.size > 1 -%}
      <ul class="product__thumbnails">
        {%- for image in product.images -%}
          <li><img src="{{ image }}" alt="{{ product.title | escape }} – {{ forloop.index }}" loading="lazy"></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="product__info">
    {%- if section.settings.show_vendor and product.vendor -%}
      <p class="product__vendor">{{ product.vendor }}</p>
    {%- endif -%}

    <h1 class="product__title">{{ product.title }}</h1>

    {% render 'price', product: product %}

    {%- if product.description -%}
      <div class="product__description rte">{{ product.description }}</div>
    {%- endif -%}

    {% form 'product', product %}
      {%- if product.options and product.options.size > 0 -%}
        <div class="product__options">
          {%- for option in product.options -%}
            <label class="product__option">
              <span>{{ option.name }}</span>
              <select name="options[{{ option.name }}]">
                {%- for value in option.values -%}
                  <option value="{{ value }}">{{ value }}</option>
                {%- endfor -%}
              </select>
            </label>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_quantity_selector -%}
        {% render 'quantity-input', name: 'quantity', value: 1 %}
      {%- endif -%}

      {%- comment -%}
        Phase 3.E: When shop has a WhatsApp phone, show WhatsApp CTA
        instead of Add-to-Cart (lead-gen mode). Otherwise show standard
        cart button. Both are shown if the merchant has checkout + WhatsApp.
      {%- endcomment -%}
      {%- unless shop.whatsapp_phone and shop.whatsapp_phone != '' -%}
        <button type="submit" name="add" class="button button--primary product__submit" {% unless product.available %}disabled{% endunless %}>
          {%- if product.available -%}
            {{ 'product.add_to_cart' | t }}
          {%- else -%}
            {{ 'product.sold_out' | t }}
          {%- endif -%}
        </button>
      {%- endunless -%}
    {% endform %}

    {% render 'whatsapp-buy', product: product, shop: shop, style: 'primary' %}

    {%- if section.settings.show_share_buttons -%}
      <div class="product__share">
        <a href="https://twitter.com/intent/tweet?url=https://{{ shop.domain }}{{ product.url }}" rel="nofollow">{{ 'product.share_twitter' | t }}</a>
        <a href="https://www.facebook.com/sharer/sharer.php?u=https://{{ shop.domain }}{{ product.url }}" rel="nofollow">{{ 'product.share_facebook' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "t:sections.main_product.settings.show_vendor.label", "default": true },
    { "type": "checkbox", "id": "show_quantity_selector", "label": "t:sections.main_product.settings.show_quantity_selector.label", "default": true },
    { "type": "checkbox", "id": "show_share_buttons", "label": "t:sections.main_product.settings.show_share_buttons.label", "default": true }
  ]
}
{% endschema %}
