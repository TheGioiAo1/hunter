<section class="image-with-text page-width">
  <div class="image-with-text__media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
    {%- else -%}
      <div class="image-with-text__placeholder"></div>
    {%- endif -%}
  </div>

  <div class="image-with-text__copy">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p>{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
      <a class="button button--secondary" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.image_with_text.settings.heading.label", "default": "Image with text" },
    { "type": "textarea", "id": "text", "label": "t:sections.image_with_text.settings.text.label" },
    { "type": "image_picker", "id": "image", "label": "t:sections.image_with_text.settings.image.label" },
    { "type": "text", "id": "link_label", "label": "t:sections.image_with_text.settings.link_label.label" },
    { "type": "url", "id": "link_url", "label": "t:sections.image_with_text.settings.link_url.label" }
  ],
  "presets": [
    { "name": "t:sections.image_with_text.presets.default.name", "category": "Image" }
  ]
}
{% endschema %}
