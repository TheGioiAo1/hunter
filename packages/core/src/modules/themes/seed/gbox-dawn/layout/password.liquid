<!doctype html>
<html lang="{{ request.locale | default: shop.default_locale | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }} – {{ 'password.title' | t }}</title>
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    {{ content_for_header }}
  </head>
  <body class="theme-body template-password">
    <main role="main" class="password-shell">
      {{ content_for_layout }}
    </main>
  </body>
</html>
