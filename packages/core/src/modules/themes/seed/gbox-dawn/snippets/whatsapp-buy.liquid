{%- comment -%}
  Phase 3.E — WhatsApp "Buy" button (lead-gen).

  When shop.whatsapp_phone is set, this renders a WhatsApp CTA button
  that opens a pre-filled chat with product details. Replaces the
  checkout flow for merchants who don't have a payment gateway yet
  (free-for-all → WhatsApp, owner decision).

  Params:
    product   — the product drop
    shop      — the shop drop
    style     — "primary" (product page) or "mini" (product card)
{%- endcomment -%}

{%- if shop.whatsapp_phone and shop.whatsapp_phone != '' -%}
  {%- assign wa_phone = shop.whatsapp_phone | remove: '+' | remove: '-' | remove: ' ' | remove: '(' | remove: ')' -%}
  {%- capture wa_message -%}Hi! I'm interested in *{{ product.title }}* ({{ product.price | money }}).

Product link: https://{{ shop.domain }}{{ product.url }}{%- endcapture -%}
  {%- assign wa_url = 'https://wa.me/' | append: wa_phone | append: '?text=' | append: wa_message | url_encode -%}

  {%- if style == 'mini' -%}
    <a href="{{ wa_url }}" target="_blank" rel="noopener noreferrer"
       class="button button--whatsapp button--whatsapp-mini"
       style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;background:#25D366;color:#fff;border-radius:6px;font-size:12px;font-weight:600;text-decoration:none;margin-top:6px">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.12.553 4.113 1.52 5.845L.05 23.71a.5.5 0 0 0 .612.612l5.865-1.47A11.94 11.94 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22a9.94 9.94 0 0 1-5.39-1.584l-.386-.232-4.012 1.003 1.003-4.012-.232-.386A9.94 9.94 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
      Buy via WhatsApp
    </a>
  {%- else -%}
    <a href="{{ wa_url }}" target="_blank" rel="noopener noreferrer"
       class="button button--whatsapp product__submit"
       style="display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:12px 24px;background:#25D366;color:#fff;border:none;border-radius:8px;font-size:15px;font-weight:600;text-decoration:none;cursor:pointer;margin-top:8px">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.12.553 4.113 1.52 5.845L.05 23.71a.5.5 0 0 0 .612.612l5.865-1.47A11.94 11.94 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22a9.94 9.94 0 0 1-5.39-1.584l-.386-.232-4.012 1.003 1.003-4.012-.232-.386A9.94 9.94 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
      Buy via WhatsApp
    </a>
  {%- endif -%}
{%- endif -%}
