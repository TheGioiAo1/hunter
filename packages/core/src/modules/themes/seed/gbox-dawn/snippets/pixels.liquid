{%- comment -%}
  Phase 3.D — Marketing pixel loader.
  Conditionally injects Meta Pixel, GTM, GA4, and TikTok Pixel scripts
  based on the shop's pixel config. Respects consent — only fires after
  user accepts the consent banner (see consent-banner.liquid).

  Expects pixel_config variable with:
    meta_pixel_id, gtm_container_id, ga4_measurement_id, tiktok_pixel_id
{%- endcomment -%}

<script>
  window.__gboxPixels = {
    meta: {{ pixel_config.meta_pixel_id | default: '' | json }},
    gtm: {{ pixel_config.gtm_container_id | default: '' | json }},
    ga4: {{ pixel_config.ga4_measurement_id | default: '' | json }},
    tiktok: {{ pixel_config.tiktok_pixel_id | default: '' | json }},
    consent: localStorage.getItem('gbox_consent') === 'accepted'
  };

  window.__gboxEventQueue = [];

  window.__gboxTrack = function(eventName, params) {
    if (!window.__gboxPixels.consent) {
      window.__gboxEventQueue.push({ event: eventName, params: params, ts: Date.now() });
      return;
    }
    _gboxFireEvent(eventName, params);
  };

  function _gboxFireEvent(eventName, params) {
    // Meta Pixel
    if (window.fbq && window.__gboxPixels.meta) {
      if (eventName === 'page_view') fbq('track', 'PageView');
      else if (eventName === 'view_item') fbq('track', 'ViewContent', params);
      else if (eventName === 'add_to_cart') fbq('track', 'AddToCart', params);
      else if (eventName === 'begin_checkout') fbq('track', 'InitiateCheckout', params);
    }

    // GA4
    if (window.gtag && window.__gboxPixels.ga4) {
      gtag('event', eventName, params);
    }

    // TikTok Pixel
    if (window.ttq && window.__gboxPixels.tiktok) {
      if (eventName === 'page_view') ttq.track('ViewContent');
      else if (eventName === 'view_item') ttq.track('ViewContent', params);
      else if (eventName === 'add_to_cart') ttq.track('AddToCart', params);
      else if (eventName === 'begin_checkout') ttq.track('InitiateCheckout', params);
    }

    // Server-side relay (for CAPI / Measurement Protocol)
    if (eventName !== 'page_view') {
      fetch('/_events', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ event: eventName, params: params }),
        keepalive: true,
        credentials: 'same-origin'
      }).catch(function() {});
    }
  }

  // Flush queued events after consent is granted.
  window.__gboxFlushQueue = function() {
    window.__gboxPixels.consent = true;
    var queue = window.__gboxEventQueue || [];
    window.__gboxEventQueue = [];
    queue.forEach(function(item) { _gboxFireEvent(item.event, item.params); });
  };
</script>

{%- if pixel_config.meta_pixel_id and pixel_config.meta_pixel_id != '' -%}
<script id="gbox-meta-pixel">
  if (window.__gboxPixels.consent) {
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', {{ pixel_config.meta_pixel_id | json }});
    fbq('track', 'PageView');
  }
</script>
<noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id={{ pixel_config.meta_pixel_id }}&ev=PageView&noscript=1"/></noscript>
{%- endif -%}

{%- if pixel_config.gtm_container_id and pixel_config.gtm_container_id != '' -%}
<script id="gbox-gtm">
  if (window.__gboxPixels.consent) {
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',{{ pixel_config.gtm_container_id | json }});
  }
</script>
{%- endif -%}

{%- if pixel_config.ga4_measurement_id and pixel_config.ga4_measurement_id != '' -%}
<script id="gbox-ga4">
  if (window.__gboxPixels.consent) {
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + {{ pixel_config.ga4_measurement_id | json }};
    document.head.appendChild(s);
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', {{ pixel_config.ga4_measurement_id | json }});
  }
</script>
{%- endif -%}

{%- if pixel_config.tiktok_pixel_id and pixel_config.tiktok_pixel_id != '' -%}
