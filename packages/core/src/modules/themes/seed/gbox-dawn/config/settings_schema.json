        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_foreground",
        "label": "t:settings_schema.colors.settings.color_foreground.label",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "t:settings_schema.colors.settings.color_accent.label",
        "default": "#1a1a1a"
      }
    ]
  },
  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "select",
        "id": "type_body_family",
        "label": "t:settings_schema.typography.settings.type_body_family.label",
        "options": [
          { "value": "system", "label": "System" },
          { "value": "serif", "label": "Serif" }
        ],
        "default": "system"
      }
    ]
  },
  {
    "name": "t:settings_schema.layout.name",
    "settings": [
