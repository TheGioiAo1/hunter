---
/**
 * Footer component — links, newsletter, social, payment icons, copyright.
 */
interface Props {
  shopName: string;
}

const { shopName } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <!-- Column 1: About -->
      <div class="site-footer__col">
        <h4>Shop</h4>
        <ul>
          <li><a href="/products">All Products</a></li>
          <li><a href="/collections">Collections</a></li>
          <li><a href="/pages/about">About Us</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        </ul>
      </div>

      <!-- Column 2: Help -->
      <div class="site-footer__col">
        <h4>Help</h4>
        <ul>
          <li><a href="/pages/shipping-policy">Shipping Policy</a></li>
          <li><a href="/pages/return-policy">Returns & Exchanges</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/size-guide">Size Guide</a></li>
        </ul>
      </div>

      <!-- Column 3: Legal -->
      <div class="site-footer__col">
        <h4>Legal</h4>
        <ul>
          <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
          <li><a href="/pages/terms-of-service">Terms of Service</a></li>
          <li><a href="/pages/refund-policy">Refund Policy</a></li>
        </ul>
      </div>

      <!-- Column 4: Newsletter -->
      <div class="site-footer__col">
        <h4>Newsletter</h4>
        <div class="footer-newsletter">
          <p>Subscribe for exclusive offers and updates.</p>
          <form class="footer-newsletter__form" action="/api/newsletter" method="post">
            <input
              type="email"
              name="email"
              placeholder="Your email"
              required
              aria-label="Email address for newsletter"
            />
            <button type="submit">Subscribe</button>
          </form>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        &copy; {year} {shopName}. All rights reserved.
      </p>

      <!-- Social icons -->
      <div class="site-footer__social">
        <a href="#" aria-label="Facebook">
          <svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
        </a>
        <a href="#" aria-label="Instagram">
          <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1"/></svg>
        </a>
        <a href="#" aria-label="X (Twitter)">
          <svg viewBox="0 0 24 24"><path d="M4 4l6.5 8L4 20h2l5.5-6.8L16 20h4l-6.8-8.3L20 4h-2l-5.2 6.4L8 4H4z"/></svg>
        </a>
      </div>

      <!-- Payment icons -->
      <div class="payment-icons">
        <!-- Visa -->
        <svg viewBox="0 0 38 24" role="img" aria-label="Visa">
          <rect width="38" height="24" rx="3" fill="#f6f6f2" stroke="#e0e0e0" stroke-width="1"/>
          <text x="19" y="15" text-anchor="middle" font-size="8" font-weight="bold" fill="#1a1f71" font-family="sans-serif">VISA</text>
        </svg>
        <!-- Mastercard -->
        <svg viewBox="0 0 38 24" role="img" aria-label="Mastercard">
          <rect width="38" height="24" rx="3" fill="#f6f6f2" stroke="#e0e0e0" stroke-width="1"/>
          <circle cx="15" cy="12" r="5" fill="#eb001b" opacity="0.8"/>
          <circle cx="23" cy="12" r="5" fill="#f79e1b" opacity="0.8"/>
        </svg>
        <!-- Amex -->
        <svg viewBox="0 0 38 24" role="img" aria-label="American Express">
          <rect width="38" height="24" rx="3" fill="#f6f6f2" stroke="#e0e0e0" stroke-width="1"/>
          <text x="19" y="15" text-anchor="middle" font-size="6" font-weight="bold" fill="#006fcf" font-family="sans-serif">AMEX</text>
        </svg>
        <!-- PayPal -->
        <svg viewBox="0 0 38 24" role="img" aria-label="PayPal">
          <rect width="38" height="24" rx="3" fill="#f6f6f2" stroke="#e0e0e0" stroke-width="1"/>
          <text x="19" y="15" text-anchor="middle" font-size="6" font-weight="bold" fill="#003087" font-family="sans-serif">PayPal</text>
        </svg>
      </div>
    </div>
  </div>
</footer>
