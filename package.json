{
  "name": "gbox-platform",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npx -y concurrently@^9 -k --names accounts,god-admin,store-admin,storefront,checkout,supporter -c blue,magenta,green,yellow,cyan,red \"npm:dev:accounts\" \"npm:dev:god-admin\" \"npm:dev:store-admin\" \"npm:dev:storefront\" \"npm:dev:checkout\" \"npm:dev:supporter\"",
    "dev:all": "npx -y concurrently@^9 -k --names accounts,god-admin,store-admin,storefront,checkout,supporter,agent -c blue,magenta,green,yellow,cyan,red,gray \"npm:dev:accounts\" \"npm:dev:god-admin\" \"npm:dev:store-admin\" \"npm:dev:storefront\" \"npm:dev:checkout\" \"npm:dev:supporter\" \"npm:dev:god-admin-agent\"",
    "dev:accounts": "npm run --workspace=apps/accounts dev",
    "dev:checkout": "npm run --workspace=apps/checkout dev",
    "dev:god-admin": "npm run --workspace=apps/god-admin dev",
    "dev:god-admin-agent": "npm run --workspace=apps/god-admin-agent dev",
    "dev:storefront": "npm run --workspace=apps/storefront dev",
    "dev:store-admin": "npm run --workspace=apps/store-admin dev",
    "dev:supporter": "npm run --workspace=apps/supporter dev",
    "build": "npm run --workspaces --if-present build",
    "db:migrate": "npm run --workspace=packages/db migrate",
    "db:seed": "npm run --workspace=packages/db seed",
    "db:generate": "npm run --workspace=packages/db generate",
    "seed:design-library": "node --import tsx scripts/seed-design-library.ts",
    "test": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/nodemailer": "^8.0.0",
    "@types/shell-quote": "^1.7.5",
    "bcrypt": "^6.0.0",
    "docx": "^9.6.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.98",
    "@aws-sdk/client-s3": "^3.1026.0",
    "@aws-sdk/s3-request-presigner": "^3.1026.0",
    "@types/multer": "^2.1.0",
    "bullmq": "^5.73.1",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "kysely": "^0.28.15",
    "liquidjs": "^10.21.0",
    "mongodb": "^6.10.0",
    "multer": "^2.1.1",
    "nanoid": "^5.0.7",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.11.0",
    "shell-quote": "^1.8.1",
    "tsx": "^4.21.0",
    "zod": "^3.25.76"
  }
}
